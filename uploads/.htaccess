# Folder upload: hanya gambar latar login. Skrip tidak boleh dijalankan, file tersembunyi / data tidak boleh dibuka.
Options -Indexes
<FilesMatch "(^\.|\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|json|txt|log|htaccess)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>